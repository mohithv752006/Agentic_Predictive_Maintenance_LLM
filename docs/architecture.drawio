;nbsp; (parallel)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;fontColor=#1f7a54;spacing=0;" vertex="1" parent="1"><mxGeometry x="712" y="204" width="220" height="16" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b style=&quot;font-size:14px;color:#1c232e&quot;&gt;Media Health&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;SMART 5 · 184 · 187&lt;br&gt;197 · 198&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;sector damage growth&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;trend tool + family model&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;→ risk 7 / 14 / 30 d&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;spacingRight=8;fillColor=#ffffff;strokeColor=#c9d0da;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12;fontColor=#1c232e;" vertex="1" parent="1"><mxGeometry x="356" y="240" width="160" height="140" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b style=&quot;font-size:14px;color:#1c232e&quot;&gt;Mechanical&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;SMART 7 · 10 · 188&lt;br&gt;240&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;seeks, retries, timeouts&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;trend tool + family model&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;→ risk 7 / 14 / 30 d&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;spacingRight=8;fillColor=#ffffff;strokeColor=#c9d0da;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12;fontColor=#1c232e;" vertex="1" parent="1"><mxGeometry x="532" y="240" width="160" height="140" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b style=&quot;font-size:14px;