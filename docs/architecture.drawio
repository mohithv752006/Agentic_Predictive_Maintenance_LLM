<mxfile host="app.diagrams.net"><diagram id="architecture" name="Architecture"><mxGraphModel dx="1400" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1200" background="#f6f7f9" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;How a drive-failure prediction runs&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=22;fontColor=#1c232e;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="-52" width="1360" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;font color=&quot;#5b6676&quot;&gt;Every probability comes from calibrated models; the LLM (Qwen3.5-4B) plans, interprets and explains.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#1c232e;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="-20" width="1360" height="20" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=2;fillColor=none;strokeColor=#2b5fb4;dashed=1;dashPattern=2 4;opacity=55;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="88" width="300" height="690" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=2;fillColor=none;strokeColor=#1f7a54;dashed=1;dashPattern=2 4;opacity=55;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="340" y="88" width="720" height="822" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=1;arcSize=2;fillColor=none;strokeColor=#a3620a;dashed=1;dashPattern=2 4;opacity=55;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1080" y="88" width="300" height="760" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style=&quot;font-size:15px;color:#2b5fb4;letter-spacing:1px&quot;&gt;1 · PLANNING&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5b6676&quot;&gt;Choose which specialists to consult&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#eaf1fb;strokeColor=#2b5fb4;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12;fontColor=#1c232e;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="300" height="56" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style=&quot;font-size:15px;color:#1f7a54;letter-spacing:1px&quot;&gt;2 · INVESTIGATION (CORE)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5b6676&quot;&gt;Collect evidence per SMART family, in parallel&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#e8f5ee;strokeColor=#1f7a54;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12;fontColor=#1c232e;" vertex="1" parent="1"><mxGeometry x="340" y="16" width="720" height="56" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style=&quot;font-size:15px;color:#a3620a;letter-spacing:1px&quot;&gt;3 · DECISION &amp;amp; REASONING&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5b6676&quot;&gt;Fuse, decide by cost, explain with citations&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#fdf3e2;strokeColor=#a3620a;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12;fontColor=#1c232e;" vertex="1" parent="1"><mxGeometry x="1080" y="16" width="300" height="56" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style=&quot;font-size:14px;color:#1c232e&quot;&gt;Prediction request&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;serial ZHZ6230H&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;as of 2025-08-10&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;cost ratio 50 · 7 / 14 / 30 d&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;spacingRight=8;fillColor=#ffffff;strokeColor=#c9d0da;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12;fontColor=#1c232e;" vertex="1" parent="1"><mxGeometry x="36" y="104" width="268" height="100" as="geometry"/></mxCell><mxCell id="c11" value="" style="html=1;rounded=0;edgeStyle=none;strokeColor=#1c232e;strokeWidth=1.4;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;fontFamily=Helvetica;fontSize=11;fontColor=#1c232e;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="204" as="sourcePoint"/><mxPoint x="170" y="234" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="&lt;b style=&quot;font-size:14px;color:#1c232e&quot;&gt;Load context&lt;/b&gt;&lt;br&gt;30-day SMART window&lt;br&gt;window features (same as training)&lt;br&gt;fleet drift report" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;spacingRight=8;fillColor=#ffffff;strokeColor=#c9d0da;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12;fontColor=#1c232e;" vertex="1" parent="1"><mxGeometry x="36" y="238" width="268" height="104" as="geometry"/></mxCell><mxCell id="c13" value="no LLM" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#f0f2f5;strokeColor=#c9d0da;fontFamily=Courier New;fontSize=10;fontColor=#5b6676;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="226" y="250" width="64" height="18" as="geometry"/></mxCell><mxCell id="c14" value="" style="html=1;rounded=0;edgeStyle=none;strokeColor=#1c232e;strokeWidth=1.4;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;fontFamily=Helvetica;fontSize=11;fontColor=#1c232e;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="342" as="sourcePoint"/><mxPoint x="170" y="372" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="&lt;b style=&quot;font-size:14px;color:#2b5fb4&quot;&gt;Planner agent&lt;/b&gt;&lt;br&gt;Qwen3.5-4B reads a feature summary,&lt;br&gt;picks agents and their priority&lt;br&gt;&lt;font color=&quot;#5b6676&quot;&gt;checked against enabled agents;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5b6676&quot;&gt;invalid or offline → run all agents&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;spacingRight=8;fillColor=#ffffff;strokeColor=#2b5fb4;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#1c232e;" vertex="1" parent="1"><mxGeometry x="36" y="376" width="268" height="118" as="geometry"/></mxCell><mxCell id="c16" value="LLM" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#f3eafb;strokeColor=#7a3fb0;fontFamily=Courier New;fontSize=10;fontColor=#7a3fb0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="226" y="388" width="64" height="18" as="geometry"/></mxCell><mxCell id="c17" value="" style="html=1;rounded=0;edgeStyle=none;strokeColor=#1c232e;strokeWidth=1.4;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;fontFamily=Helvetica;fontSize=11;fontColor=#1c232e;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="494" as="sourcePoint"/><mxPoint x="170" y="524" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="&lt;b style=&quot;font-size:14px;color:#1c232e&quot;&gt;Plan (from a real run)&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;1 media_health&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;2 usage_wear&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;3 mechanical&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;4 thermal&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;5 fleet_context&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;6 case_retrieval&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;7 knowledge_retrieval&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;spacingRight=8;fillColor=#ffffff;strokeColor=#c9d0da;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12;fontColor=#1c232e;" vertex="1" parent="1"><mxGeometry x="36" y="528" width="268" height="168" as="geometry"/></mxCell><mxCell id="c19" value="plan" style="html=1;rounded=0;edgeStyle=none;strokeColor=#1c232e;strokeWidth=1.4;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;fontFamily=Helvetica;fontSize=11;fontColor=#1c232e;labelBackgroundColor=none;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="304" y="612" as="sourcePoint"/><mxPoint x="352" y="150" as="targetPoint"/><Array as="points"><mxPoint x="330" y="612"/><mxPoint x="330" y="150"/></Array></mxGeometry></mxCell><mxCell id="c20" value="LLM offline: default plan, template&lt;br&gt;summaries; probabilities and decision&lt;br&gt;unchanged (llm_available: false)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;spacingRight=8;fillColor=#f0f2f5;strokeColor=none;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12;fontColor=#1c232e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="36" y="708" width="268" height="58" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b style=&quot;font-size:14px;color:#1f7a54&quot;&gt;Controller (orchestrator)&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#5b6676&quot;&gt;LangGraph state machine&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;spacingRight=8;fillColor=#ffffff;strokeColor=#1f7a54;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#1c232e;" vertex="1" parent="1"><mxGeometry x="356" y="104" width="688" height="98" as="geometry"/></mxCell><mxCell id="c22" value="no LLM" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#f0f2f5;strokeColor=#c9d0da;fontFamily=Courier New;fontSize=10;fontColor=#5b6676;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="964" y="116" width="64" height="18" as="geometry"/></mxCell><mxCell id="c23" value="• sends the plan&#x27;s agents out in parallel&lt;br&gt;• merges their findings into shared state&lt;br&gt;• streams every step to the dashboard" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#1c232e;spacing=0;" vertex="1" parent="1"><mxGeometry x="374" y="140" width="330" height="60" as="geometry"/></mxCell><mxCell id="c24" value="• counts failed agents → re-plan once&lt;br&gt;• one agent failing never stops the run&lt;br&gt;• checkpoints each run (SQLite)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#1c232e;spacing=0;" vertex="1" parent="1"><mxGeometry x="710" y="140" width="330" height="60" as="geometry"/></mxCell><mxCell id="c25" value="" style="html=1;rounded=0;edgeStyle=none;strokeColor=#1f7a54;strokeWidth=1.4;dashed=1;dashPattern=5 4;endArrow=none;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;fontFamily=Helvetica;fontSize=11;fontColor=#1c232e;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="202" as="sourcePoint"/><mxPoint x="700" y="220" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="" style="html=1;rounded=0;edgeStyle=none;strokeColor=#1f7a54;strokeWidth=1.4;dashed=1;dashPattern=5 4;endArrow=none;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;fontFamily=Helvetica;fontSize=11;fontColor=#1c232e;labelBackgroundColor=none;" edge="1" pare